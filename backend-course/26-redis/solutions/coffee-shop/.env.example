# העתק ל־.env ומלא. .env לא נכנס ל־Git.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/coffee_shop"
DATABASE_URL_TEST="postgresql://postgres:YOUR_PASSWORD@localhost:5432/coffee_shop_test"

# 32+ תווים אקראיים: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# המנהל הראשון — נוצר בעלייה
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# אופציונלי (ברירות מחדל)
# Redis (פרק 26) — רשות. בלעדיו: בלי cache, ומייל האישור נשלח מיד
# REDIS_URL=redis://localhost:6379
# REDIS_PREFIX=shop
# PRODUCTS_CACHE_TTL_SECONDS=60
# ORDER_PAYMENT_TIMEOUT_SECONDS=1800   # הזמנה שלא שולמה — מתבטלת
# WORKER=true                          # false: ה־API רק מוסיף לתור, ותהליך אחר מעבד
# ACCESS_TOKEN_TTL_SECONDS=3600
# BCRYPT_ROUNDS=12
# IDEMPOTENCY_TTL_HOURS=24
# CORS_ORIGINS=http://localhost:5500
# פרודקשן: NODE_ENV=production, CORS_ORIGINS עם https, TRUST_PROXY=1
