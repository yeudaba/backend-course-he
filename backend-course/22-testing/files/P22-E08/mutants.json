{
  "subject": "P22-E08.ts",
  "mutants": [
    {
      "desc": "offset של עמוד 1 הוא limit במקום 0",
      "replace": [
        [
          "offset: (page - 1) * limit",
          "offset: page * limit"
        ]
      ]
    },
    {
      "desc": "limit שווה ל־maxLimit נדחה",
      "replace": [
        [
          "limit > maxLimit",
          "limit >= maxLimit"
        ]
      ]
    },
    {
      "desc": "page=0 מתקבל",
      "replace": [
        [
          "page < 1",
          "page < 0"
        ]
      ]
    },
    {
      "desc": "שגיאה מסוג TypeError במקום RangeError",
      "replace": [
        [
          "throw new RangeError(`page",
          "throw new TypeError(`page"
        ]
      ]
    },
    {
      "desc": "limit לא שלם (2.5) מתקבל",
      "replace": [
        [
          "!Number.isInteger(limit)",
          "!Number.isFinite(limit)"
        ]
      ]
    },
    {
      "desc": "ברירת המחדל של limit מתעלמת מהאופציה",
      "replace": [
        [
          "? defaultLimit :",
          "? 20 :"
        ]
      ]
    },
    {
      "desc": "limit=0 מתקבל",
      "replace": [
        [
          "limit < 1 ||",
          "limit < 0 ||"
        ]
      ]
    },
    {
      "desc": "maxLimit מהאופציה לא נבדק (תמיד 50)",
      "replace": [
        [
          "limit > maxLimit",
          "limit > 50"
        ]
      ]
    },
    {
      "desc": "page לא שלם (1.5) מתקבל",
      "replace": [
        [
          "!Number.isInteger(page)",
          "!Number.isFinite(page)"
        ]
      ]
    }
  ]
}
