{
  "subject": "P22-E25.ts",
  "mutants": [
    { "desc": "בקשה אחת יותר מהמותר עוברת", "replace": [["recent.length >= this.limit", "recent.length > this.limit"]] },
    { "desc": "הבקשות לא \"יוצאות\" מהחלון", "replace": [[".filter((t) => t > now - this.windowMs)", ""]] },
    { "desc": "בקשה שבדיוק בגבול החלון עדיין נספרת", "replace": [["t > now - this.windowMs", "t >= now - this.windowMs"]] },
    { "desc": "בקשה שנדחתה כן נספרת", "replace": [["      this.hits.set(key, recent);\n      return { allowed: false", "      recent.push(now);\n      this.hits.set(key, recent);\n      return { allowed: false"]] },
    { "desc": "מונה אחד לכל המפתחות", "replace": [["const recent = (this.hits.get(key) ?? [])", "const recent = (this.hits.get(\"*\") ?? [])"], ["    recent.push(now);\n    this.hits.set(key, recent);", "    recent.push(now);\n    this.hits.set(\"*\", recent);"]] },
    { "desc": "retryAfterMs מחושב מהבקשה האחרונה במקום הראשונה", "replace": [["recent[0] + this.windowMs - now", "recent[recent.length - 1] + this.windowMs - now"]] },
    { "desc": "remaining לא מתעדכן", "replace": [["remaining: this.limit - recent.length", "remaining: this.limit"]] }
  ]
}
