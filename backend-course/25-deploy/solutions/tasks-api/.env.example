# העתק ל־.env ומלא. את .env לא מכניסים ל־Git (הוא ב־.gitignore).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tasks_api"
# בענן (Neon): הכתובת שהם נותנים, כולל ?sslmode=require — השרת מתחבר ב־TLS עם בדיקת תעודה

# סוד לחתימת JWT: לפחות 32 תווים אקראיים. ליצירה:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# אופציונלי (אלה ברירות המחדל)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_ROUNDS=12
# CORS_ORIGINS=http://localhost:5500
# LOG_LEVEL=info                  # debug | info | warn | error
# AUTH_RATE_LIMIT_PER_MINUTE=10   # ניסיונות register/login לכל IP בדקה
# IDEMPOTENCY_TTL_HOURS=24        # כמה זמן נשמרת תשובה ל־Idempotency-Key
# TRUST_PROXY=1                   # רק מאחורי proxy מוכר (פרק 25): כמה proxies לפני השרת. אחרת — X-Forwarded-For מזויף

# פרודקשן (פרק 25) — בפלטפורמה, לא בקובץ:
# NODE_ENV=production            # מחייב DATABASE_URL ו־CORS_ORIGINS עם https
# PORT=10000                     # הפלטפורמה קובעת; בלי — 3000
# GIT_COMMIT=<sha>               # מוצג ב־/version (ב־Render: RENDER_GIT_COMMIT, אוטומטי)
