// P19-E90: לקוחות והזמנות — validate עובר, אבל אף דרישה לא מתקיימת.
// email ייחודי · לקוח עם הזמנות לא נמחק · notes לא חובה · index על customer_id
//
// בדיקה:  npm run check P19-E90
datasource db {
  provider = "postgresql"
}

model Customer {
  id     Int     @id @default(autoincrement())
  email  String
  orders Order[]

  @@map("customers")
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  total      Decimal  @db.Decimal(10, 2)
  notes      String

  @@map("orders")
}
