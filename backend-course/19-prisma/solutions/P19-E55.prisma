datasource db {
  provider = "postgresql"
}

model Employee {
  id    Int    @id @default(autoincrement())
  name  String
  tasks Task[]

  @@map("employees")
}

model Task {
  id         Int       @id @default(autoincrement())
  title      String
  assigneeId Int?      @map("assignee_id")
  assignee   Employee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@map("tasks")
}
