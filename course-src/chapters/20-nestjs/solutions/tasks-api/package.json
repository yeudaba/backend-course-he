{
  "name": "tasks-api",
  "version": "1.0.0",
  "description": "API לניהול משימות — NestJS, TypeScript, Zod, PostgreSQL ו־Prisma",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "web": "node scripts/serve-web.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.0",
    "@nestjs/core": "^12.3.0",
    "@nestjs/platform-express": "^12.3.0",
    "@nestjs/swagger": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.0",
    "prisma": "^7.10.1",
    "typescript": "^6.0.2"
  }
}
