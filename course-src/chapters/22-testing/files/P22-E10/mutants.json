{
  "subject": "P22-E10.ts",
  "env": {
    "TZ": "Asia/Jerusalem"
  },
  "mutants": [
    {
      "desc": "\"היום\" לפי השעון המקומי במקום UTC",
      "replace": [
        [
          "now.toISOString().slice(0, 10)",
          "now.toLocaleDateString(\"sv-SE\")"
        ]
      ]
    },
    {
      "desc": "היום עצמו נחשב באיחור",
      "replace": [
        [
          "dueDate < today",
          "dueDate <= today"
        ]
      ]
    },
    {
      "desc": "בדיוק 3 ימים ← later במקום soon",
      "replace": [
        [
          "days <= 3",
          "days < 3"
        ]
      ]
    },
    {
      "desc": "בלי תאריך ← later במקום none",
      "replace": [
        [
          "return \"none\";",
          "return \"later\";"
        ]
      ]
    },
    {
      "desc": "4 ימים ← soon במקום later",
      "replace": [
        [
          "days <= 3",
          "days <= 4"
        ]
      ]
    },
    {
      "desc": "מחר ← later (soon רק מיומיים)",
      "replace": [
        [
          "return days <= 3 ? \"soon\" : \"later\";",
          "return days >= 2 && days <= 3 ? \"soon\" : \"later\";"
        ]
      ]
    }
  ]
}
