{
  "subject": "P29-E27.ts",
  "variants": [
    { "desc": "\\w במקום אותיות וספרות לפני ה־@", "replace": [["/[A-Za-z0-9._%+-]+@", "/[\\w.%+-]+@"]] },
    { "desc": "replaceAll ושלוש שורות", "replace": [["return text.replace(EMAIL, \"[EMAIL]\").replace(CARD, \"[CARD]\").replace(PHONE, \"[PHONE]\");", "let out = text.replaceAll(EMAIL, \"[EMAIL]\");\n  out = out.replaceAll(CARD, \"[CARD]\");\n  return out.replaceAll(PHONE, \"[PHONE]\");"]] }
  ],
  "mutants": [
    { "desc": "אימייל בלי + לפני ה־@", "replace": [["/[A-Za-z0-9._%+-]+@", "/[A-Za-z0-9._%-]+@"]] },
    { "desc": "דומיין בלי נקודות באמצע (shop.co.il)", "replace": [["@[A-Za-z0-9.-]+\\.", "@[A-Za-z0-9-]+\\."]] },
    { "desc": "סיומת של 3 אותיות לפחות (.il לא עובר)", "replace": [["[A-Za-z]{2,}/g", "[A-Za-z]{3,}/g"]] },
    { "desc": "אימייל בלי g — רק הראשון", "replace": [["[A-Za-z]{2,}/g;", "[A-Za-z]{2,}/;"]] },
    { "desc": "כרטיס מ־12 ספרות (מספר הזמנה נמחק)", "replace": [["{12,15}\\d", "{11,15}\\d"]] },
    { "desc": "כרטיס מ־14 ספרות", "replace": [["{12,15}\\d", "{13,15}\\d"]] },
    { "desc": "כרטיס בלי רווחים ומקפים", "replace": [["(?:\\d[ -]?){12,15}", "(?:\\d){12,15}"]] },
    { "desc": "כרטיס בלי \\b (חלק ממספר ארוך נמחק)", "replace": [["/\\b(?:\\d[ -]?){12,15}\\d\\b/g", "/(?:\\d[ -]?){12,15}\\d/g"]] },
    { "desc": "טלפון בלי +972", "replace": [["(?:\\+972[- ]?|\\b0)5", "\\b05"]] },
    { "desc": "טלפון בלי מפרידים", "replace": [["5\\d[- ]?\\d{3}[- ]?\\d{4}", "5\\d\\d{3}\\d{4}"]] },
    { "desc": "טלפון: גם קווי (0X)", "replace": [["|\\b0)5\\d", "|\\b0)\\d\\d?"]] },
    { "desc": "טלפון בלי g — רק הראשון", "replace": [["\\d{4}\\b/g;", "\\d{4}\\b/;"]] }
  ]
}
