// P19-E89: ה־schema עובר validate, אבל הטבלה לא מתאימה. ארבע תקלות.
// צריך: טבלה products · id ממוספר · name · price numeric(10,2) · in_stock (ברירת מחדל 0) · is_active (ברירת מחדל true)
//
// בדיקה:  npm run check P19-E89
datasource db {
  provider = "postgresql"
}

model Product {
  id       Int     @id
  name     String
  price    Float
  inStock  Int     @default(0) @map("in_stock")
  isActive Boolean @default(true)
}
