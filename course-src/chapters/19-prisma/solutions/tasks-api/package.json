{
  "name": "tasks-api",
  "version": "1.0.0",
  "description": "API לניהול משימות — Express, TypeScript, Zod, PostgreSQL ו־Prisma",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "web": "node scripts/serve-web.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "pg": "^8.13.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.2.0",
    "prisma": "^7.10.1",
    "typescript": "^5.9.0"
  }
}
