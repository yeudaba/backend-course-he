{
  "//": "הגדרות TypeScript של הקורס (פרק 11). VS Code קורא את הקובץ הזה ומסמן שגיאות טיפוסים בעורך.",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "**/solutions/**"]
}
